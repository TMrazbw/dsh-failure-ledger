{
  "name": "@local/dsh-failure-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "description": "Conversation anomaly statistics for DSH: failure ledger, large-error digest, per-turn reminder, token-savings panel, and retention controls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMrazbw/dsh-failure-ledger.git"
  },
  "homepage": "https://github.com/TMrazbw/dsh-failure-ledger",
  "bugs": {
    "url": "https://github.com/TMrazbw/dsh-failure-ledger/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "vendor/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
